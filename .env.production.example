WEAVIATE_HOST_URL=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_HOST_URL=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SECURE=false

# Set the API key that matches features.chat.provider in config.json
# For Anthropic:
ANTHROPIC_API_KEY=

# For OpenAI:
OPENAI_API_KEY=

# For OpenAI-compatible providers:
AI_API_KEY=

# Site Access
# If SITE_PASSWORD is empty, missing, or not in env,
# the portal is open and not password protected.
SITE_PASSWORD=
