WEAVIATE_HOST_URL=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_HOST_URL=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SECURE=false
WEAVIATE_RESET_SCHEMA=true

# Chat API keys
# Choose provider/model/baseUrl in config.json under features.chat.
# Keep only the key for the provider you use.

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenAI-compatible providers (optional fallback key name)
AI_API_KEY=

# Site Access
# If SITE_PASSWORD is empty, missing, or not in env,
# the portal is open and not password protected.
SITE_PASSWORD=

# Portal Sync (optional) — pull published recordings from Portal Publisher.
# See docs/PORTAL_SYNC.md. Leave PORTAL_PUBLISHER_URL / PORTAL_SYNC_TOKEN empty to keep sync off.
PORTAL_PUBLISHER_URL=
# Shown once when the portal is created in Portal Publisher (pps_...). Keep it secret.
PORTAL_SYNC_TOKEN=
# Poll interval in minutes (default 15). 0 = no polling; sync on startup and "sync now" pings only.
PORTAL_SYNC_INTERVAL_MINUTES=15
# Port of the internal portal-sync service (not published to the host). The frontend's
# /api/portal-sync route forwards pings to http://PORTAL_SYNC_HOST:PORTAL_SYNC_PORT/trigger.
PORTAL_SYNC_PORT=7171
PORTAL_SYNC_HOST=portal-sync
# Optional shell command run after each recording is (re)processed.
# Gets STORY_ID, STORY_UUID, COLLECTION_ID, STORY_FILE in its env; non-zero exit marks the item failed.
# Entities and Explore excerpts for synced recordings use the chat LLM above (config.json features.chat).
# PORTAL_SYNC_NER=llm          # llm | gliner | off
# PORTAL_SYNC_EXCERPTS=on      # on | off
PORTAL_SYNC_POST_PROCESS_COMMAND=
